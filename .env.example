# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# HELIUS_API_KEY: Optional server-side Helius API key for Enhanced Solana Transactions & RPC.
HELIUS_API_KEY=

# VITE_SUPABASE_URL & VITE_SUPABASE_ANON_KEY: Optional Supabase project credentials for Auth & Profiles.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY: Optional server-side key to sync verified tier upgrades to Supabase profiles.
SUPABASE_SERVICE_ROLE_KEY=
